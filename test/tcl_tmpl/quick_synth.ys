# Load the yosuf plugin (shared lib) in the command-line option when launching
plugin -l
help
# Read verilog
read_verilog ../etc/benchmarks/ubm/simple_gates/and2/and2.v
# Run synthesis
synth_sofa -top and2 -family sofa-hd -blif and2.blif -verilog and2_post_synth.v
# Reports
tee -o stats.json stat -json
